# Cloudflare Workers static-assets headers.
# Big static binaries get a 1-year immutable cache — Lighthouse's
# "Use efficient cache lifetimes" insight wants this for the OG png
# and the favicons. HTML keeps the default (must-revalidate) so
# deploys propagate immediately.

/og-v2.png
  Cache-Control: public, max-age=31536000, immutable

/og-v3.png
  Cache-Control: public, max-age=31536000, immutable

/og-card.html
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# Text surfaces must declare charset explicitly. Workers Assets serves
# these as `text/markdown` / `text/plain` with NO charset parameter, and a
# client that then falls back to Latin-1 renders every UTF-8 multi-byte
# character as mojibake — an em dash becomes "a<80><94>", U+00D7 becomes
# "A-". index.html is unaffected because it carries <meta charset>; raw
# .md and .txt have no in-band way to say it, so it must come from here.

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/setup.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/index.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/topologies.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Generated by site/build-docs.sh from the .md above. HTML declares its own
# charset via <meta>, so these only need a cache policy.
/setup.html
  Cache-Control: public, max-age=3600

/topologies.html
  Cache-Control: public, max-age=3600
